# ── LR Time / SecurePoint — variables d'environnement frontend ──────────────
# Copier vers .env.local et adapter les valeurs.

# URL de base du backend Django (sans slash final).
NEXT_PUBLIC_EMPLOYEE_API_BASE_URL=http://localhost:8000

# Clé publiable Stripe (facultatif — requise seulement pour le paiement par
# Stripe Elements ; le checkout hébergé fonctionne sans).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Variables supprimées (ne plus utiliser) ─────────────────────────────────
# NEXT_PUBLIC_EMPLOYEE_API_USERNAME / NEXT_PUBLIC_EMPLOYEE_API_PASSWORD :
#   le compte de service embarqué dans le bundle a été supprimé — l'API exige
#   une session utilisateur (login).
# NEXT_PUBLIC_HIK_EVENTS_TENANT / NEXT_PUBLIC_EMPLOYEE_TENANT_CODE /
# NEXT_PUBLIC_TENANT_CODE :
#   le tenant actif vient désormais de la session (sélecteur d'organisation
#   dans l'en-tête).
# NEXT_PUBLIC_EMPLOYEE_API_ENABLED : l'API est toujours active.
# NEXT_PUBLIC_DEVICE_CONFIG_PATH / NEXT_PUBLIC_DEVICE_CONFIG_SCHEME :
#   le bouton « interface de configuration » appareil a été retiré
#   (endpoint inexistant côté backend).
# NEXT_PUBLIC_API_BASE_URL : remplacée par NEXT_PUBLIC_EMPLOYEE_API_BASE_URL.
